# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# ----- Blockchain (used by Truffle deployment only; never sent to the browser) -----
# HTTPS endpoint of an Ethereum Sepolia RPC provider (Infura, Alchemy, QuickNode, ...).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Private key of a THROW-AWAY test wallet that holds Sepolia ETH. This wallet becomes
# the contract owner (administrator). Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=
# Title stored in the contract at deployment (can be changed later by the owner before voting starts).
ELECTION_TITLE=ChainVote Election

# ----- Backend (FastAPI + MySQL) -----
# Long random string, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chainvote
MYSQL_PASSWORD=
MYSQL_DATABASE=chainvote
# Optional: full SQLAlchemy URL. Overrides the MYSQL_* values above.
# DATABASE_URL=

# Optional: comma-separated origins allowed to call the API from another origin.
# Leave empty when the frontend is served by the backend (same origin).
CORS_ORIGINS=
